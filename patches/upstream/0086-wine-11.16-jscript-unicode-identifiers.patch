 /* ECMA-262 3rd Edition    7.6 */
-BOOL is_identifier_char(WCHAR c)
+static BOOL is_identifier_first_char(WCHAR c)
 {
-    return iswalnum(c) || c == '$' || c == '_' || c == '\\';
