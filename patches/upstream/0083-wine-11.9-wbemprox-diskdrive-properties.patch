From: Esme Povirk <esme@codeweavers.com>
Subject: [PATCH] wbemprox: Stub Win32_DiskDrive TotalHeads and Signature properties.

Backported from WineHQ commit caba5e68e2 (wine-11.9) without code
changes.

Queries that select these Win32_DiskDrive columns failed because the
columns did not exist. Report a signature of 0 and 255 heads.

diff --git a/dlls/wbemprox/builtin.c b/dlls/wbemprox/builtin.c
--- a/dlls/wbemprox/builtin.c
+++ b/dlls/wbemprox/builtin.c
@@ -155,7 +155,9 @@ static const struct column col_diskdrive[] =
     { L"Model",         CIM_STRING },
     { L"PNPDeviceID",   CIM_STRING },
     { L"SerialNumber",  CIM_STRING|COL_FLAG_DYNAMIC },
+    { L"Signature",     CIM_UINT32 },
     { L"Size",          CIM_UINT64 },
+    { L"TotalHeads",    CIM_UINT32 },
 };
 static const struct column col_diskdrivetodiskpartition[] =
 {
@@ -740,7 +742,9 @@ struct record_diskdrive
     const WCHAR *model;
     const WCHAR *pnpdevice_id;
     const WCHAR *serialnumber;
+    UINT32       signature;
     UINT64       size;
+    UINT32       total_heads;
 };
 struct record_diskdrivetodiskpartition
 {
@@ -2700,8 +2704,10 @@ static enum fill_status fill_diskdrive( struct table *table, const struct expr *
             rec->model         = L"Wine Disk Drive";
             rec->pnpdevice_id  = L"IDE\\Disk\\VEN_WINE";
             rec->serialnumber  = get_diskdrive_serialnumber( root[0] );
+            rec->signature     = 0;
             get_freespace( root, &size );
             rec->size          = size;
+            rec->total_heads   = 255;
             if (!match_row( table, row, cond, &status ))
             {
                 free_row_values( table, row );
