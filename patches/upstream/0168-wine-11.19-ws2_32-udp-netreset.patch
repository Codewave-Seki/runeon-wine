From: Mikhail Zhadanov <mzhadanov@gmail.com>
Subject: [PATCH] ws2_32: Add support for SIO_UDP_NETRESET.

Backport of WineHQ commit 19d5fbd382 (wine-11.19), applied unchanged on
top of patches 0001-0167; its test hunk is omitted. WSAIoctl() failed
SIO_UDP_NETRESET with WSAEOPNOTSUPP (10045); it is now accepted like
SIO_UDP_CONNRESET, which Wine also only stubs. A program that treats
the failure as fatal, for example when setting up a UDP matchmaking
socket, no longer stops there.

diff --git a/dlls/ws2_32/socket.c b/dlls/ws2_32/socket.c
index f4cca3a..1ca8574 100644
--- a/dlls/ws2_32/socket.c
+++ b/dlls/ws2_32/socket.c
@@ -2242,6 +2242,7 @@ static const char *debugstr_wsaioctl(DWORD code)
         IOCTL_NAME(SIO_SET_QOS);
         IOCTL_NAME(SIO_TRANSLATE_HANDLE);
         IOCTL_NAME(SIO_UDP_CONNRESET);
+        IOCTL_NAME(SIO_UDP_NETRESET);
     }
 #undef IOCTL_NAME
 
@@ -2678,11 +2679,12 @@ INT WINAPI WSAIoctl(SOCKET s, DWORD code, LPVOID in_buff, DWORD in_size, LPVOID
     }
 
     case SIO_UDP_CONNRESET:
+    case SIO_UDP_NETRESET:
     {
         NTSTATUS status = STATUS_SUCCESS;
         DWORD ret;
 
-        FIXME( "SIO_UDP_CONNRESET stub\n" );
+        FIXME( "%s stub\n", debugstr_wsaioctl( code ) );
         ret = server_ioctl_sock( s, IOCTL_AFD_WINE_COMPLETE_ASYNC, &status, sizeof(status),
                                  NULL, 0, ret_size, overlapped, completion );
         SetLastError( ret );
diff --git a/include/mswsock.h b/include/mswsock.h
index fa97d5b..2a6d2a2 100644
--- a/include/mswsock.h
+++ b/include/mswsock.h
@@ -84,10 +84,12 @@ extern "C" {
 
 #ifndef USE_WS_PREFIX
 #define SIO_UDP_CONNRESET               _WSAIOW(IOC_VENDOR, 12)
+#define SIO_UDP_NETRESET                _WSAIOW(IOC_VENDOR, 15)
 #define SIO_SET_COMPATIBILITY_MODE      _WSAIOW(IOC_VENDOR, 300)
 #define SIO_BASE_HANDLE                 _WSAIOR(IOC_WS2, 34)
 #else
 #define WS_SIO_UDP_CONNRESET            _WSAIOW(WS_IOC_VENDOR, 12)
+#define WS_SIO_UDP_NETRESET             _WSAIOW(WS_IOC_VENDOR, 15)
 #define WS_SIO_SET_COMPATIBILITY_MODE   _WSAIOW(WS_IOC_VENDOR, 300)
 #define WS_SIO_BASE_HANDLE              _WSAIOR(WS_IOC_WS2, 34)
 #endif
