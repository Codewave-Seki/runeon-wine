-                diff_solid = 4.0f / ((1.0f + u * u + v * v) * sqrtf(1.0f + u * u + v * v));
-                Wt += diff_solid;
-
-                D3DXVec3Normalize(&dir, &dir);
-                D3DXSHEvalDirection(temp, order, &dir);
-
-                format_to_d3dx_color(format, &row[x * format->block_byte_count], NULL, &colour);
-
-                for (i = 0; i < order_square; ++i)
