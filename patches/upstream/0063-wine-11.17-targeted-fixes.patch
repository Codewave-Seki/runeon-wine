+static BOOL is_valid_enumerator(const WCHAR *enumerator)
+{
+    WCHAR *tmp;
+
+    if (!enumerator[0])
+        return FALSE;
+    if (!(tmp = wcschr(enumerator, '\\')))
+        return TRUE;
+    /* Cannot have more than one '\'. */
+    if (!!wcschr(tmp + 1, '\\'))
+        return FALSE;
+    /* Enumerator can't end with '\'. */
+    if (tmp[1] == '\0')
+        return FALSE;
+
+    return TRUE;
+}
