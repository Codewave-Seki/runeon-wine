  * configuration changed.  Main thread only. */
 static BOOL activation_resync_needed = TRUE;
 
+/* Relative mouse mode state shared with Wine threads and the raw input queue.
+ * The main thread enters and leaves the mode; while it is on, Wine threads
+ * record the client's cursor position here instead of warping the Mac
+ * pointer, and the raw input queue delivers motion to raw_window. */
+static os_unfair_lock relative_lock = OS_UNFAIR_LOCK_INIT;
+static int relative_on;             /* atomic; written under relative_lock */
+static CGPoint relative_position;   /* Wine coordinates, under relative_lock */
+static BOOL relative_clipped;       /* under relative_lock */
+static CGRect relative_clip;        /* the client's clip rectangle, Wine coordinates, under relative_lock */
+static WineWindow* raw_window;      /* raw motion target, under relative_lock */
+static int raw_on;                  /* atomic; raw_window is set, written under relative_lock */
+static unsigned long long raw_last_motion;  /* atomic; uptime ns of the latest raw motion */
+
+/* At most this often (ns): each delivery costs the client thread a Wine
+ * server call, and gaming mice report up to 8,000 times a second. */
+static const unsigned long long raw_interval = 1000000;
+/* Raw motion this recent (ns) carries the movement, so pointer events are
+ * ignored; after it, pointer events stand in (a mouse GCMouse does not report). */
+static const unsigned long long raw_silence = 250000000;
+
+/* raw_queue only */
+static dispatch_queue_t raw_queue;
+static dispatch_source_t raw_timer;
+static double raw_pending_x, raw_pending_y;
+static unsigned long long raw_last_post;
+static BOOL raw_flush_armed;
+
+static unsigned long long uptime_ns(void)
+{
+    return clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+/* Follows Wine's cursor, as Wine clips it, to place the Mac pointer when the
+ * mode ends.  Called with relative_lock held. */
+static void relative_move_position(int x, int y)
+{
+    relative_position.x += x;
+    relative_position.y += y;
+    if (relative_clipped)
+    {
+        relative_position.x = MAX(CGRectGetMinX(relative_clip), MIN(relative_position.x, CGRectGetMaxX(relative_clip) - 1));
+        relative_position.y = MAX(CGRectGetMinY(relative_clip), MIN(relative_position.y, CGRectGetMaxY(relative_clip) - 1));
+    }
+}
+
+/* Delivers the whole counts received so far; the fraction stays pending. */
+static void raw_flush(void)
+{
+    int x = raw_pending_x, y = raw_pending_y;  /* truncation keeps the remainder */
+    unsigned long long now = uptime_ns();
+
+    raw_flush_armed = FALSE;
+    if (!x && !y) return;
+
+    os_unfair_lock_lock(&relative_lock);
+    if (raw_window)
+    {
+        macdrv_event* event = macdrv_create_event(MOUSE_MOVED_RELATIVE, raw_window);
+        event->mouse_moved.x = x;
+        event->mouse_moved.y = y;
+        event->mouse_moved.time_ms = [[WineApplicationController sharedController] ticksForEventTime:now / 1e9];
+        [raw_window.queue postEvent:event];
+        macdrv_release_event(event);
+        relative_move_position(x, y);
+        raw_pending_x -= x;
+        raw_pending_y -= y;
+        raw_last_post = now;
+    }
+    else
+        raw_pending_x = raw_pending_y = 0;
+    os_unfair_lock_unlock(&relative_lock);
+}
+
+/* A GCMouse report: whole mouse counts, without macOS's pointer acceleration,
+ * as Windows gives games.  Delivered at most once per raw_interval; motion in
+ * between accumulates and is never dropped. */
+static void raw_motion(float dx, float dy)
+{
+    unsigned long long now = uptime_ns();
+
+    __atomic_store_n(&raw_last_motion, now, __ATOMIC_RELAXED);
+    if (!__atomic_load_n(&raw_on, __ATOMIC_ACQUIRE))
+    {
+        raw_pending_x = raw_pending_y = 0;
+        return;
+    }
+
+    raw_pending_x += dx;
+    raw_pending_y -= dy;  /* GCMouse's Y axis points up, Windows' down */
+    if (now - raw_last_post >= raw_interval)
+        raw_flush();
+    else if (!raw_flush_armed)
+    {
+        raw_flush_armed = TRUE;
+        dispatch_source_set_timer(raw_timer, dispatch_time(DISPATCH_TIME_NOW, raw_last_post + raw_interval - now),
+                                  DISPATCH_TIME_FOREVER, 0);
+    }
+}
+
+/* Whether every frame of a cursor is fully transparent: some clients hide the
+ * cursor by setting an empty image rather than no cursor. */
+static BOOL cursor_frames_transparent(NSArray* frames)
+{
+    if (![frames count]) return NO;
+    for (NSDictionary* frame in frames)
+    {
+        CGImageRef image = (CGImageRef)frame[@"image"];
+        size_t width = CGImageGetWidth(image), height = CGImageGetHeight(image), i;
+        unsigned char* pixels;
+        CGColorSpaceRef space;
+        CGContextRef context;
+        BOOL clear = NO;
+
+        if (!width || !height || width > 512 || height > 512) return NO;
+        if (!(pixels = calloc(width * height, 4))) return NO;
+        space = CGColorSpaceCreateDeviceRGB();
+        context = CGBitmapContextCreate(pixels, width, height, 8, width * 4, space,
+                                        (CGBitmapInfo)kCGImageAlphaPremultipliedLast);
+        if (context)
+        {
+            CGContextDrawImage(context, CGRectMake(0, 0, width, height), image);
+            clear = YES;
+            for (i = 0; i < width * height; i++)
+                if (pixels[i * 4 + 3]) { clear = NO; break; }
+            CGContextRelease(context);
+        }
+        CGColorSpaceRelease(space);
+        free(pixels);
+        if (!clear) return NO;
+    }
+    return YES;
+}
