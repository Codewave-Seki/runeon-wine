     }
 
+    /*
+     * Relative mouse mode
+     *
+     * A Windows game aims by hiding the cursor, then confining it (ClipCursor)
+     * or moving it back to the centre every frame (SetCursorPos), and reading
+     * the motion.  Done literally on macOS, every re-centre is a synchronous
+     * warp of the Mac pointer while the game thread waits, each warp discards
+     * the motion queued behind it, and the motion carries macOS's pointer
+     * acceleration.
+     *
+     * Instead, while the client hides the cursor and confines or re-centres
+     * it, freeze the Mac pointer and deliver all motion as relative movement:
+     * Wine's cursor position is authoritative, re-centring and position
+     * queries are answered by Wine threads without this thread, clicks and
+     * scrolls happen at Wine's position, and the pointer reappears there when
+     * the mode ends.  The motion is raw mouse counts from GCMouse, at the
+     * mouse's report rate; pointer events stand in for trackpads and for a
+     * mouse GCMouse does not report.
+     *
+     * The mode follows what the client does, never which program it is.  The
+     * Mac Driver option RelativeMouse=N turns it off.
+     */
+    - (WineWindow*) relativeMouseTarget
+    {
+        WineWindow* window;
+
+        if (!relative_mouse || ![NSApp isActive])
+            return nil;
+        if (!clientWantsCursorHidden && !cursorTransparent)
+            return nil;
+        if (!self.clippingCursor && !relativeMouseHiddenWarp)
+            return nil;
+        // The event tap clipping handler moves the pointer itself.
+        if (clipCursorHandler && ![clipCursorHandler isKindOfClass:[WineConfinementClipCursorHandler class]])
+            return nil;
+        if ([windowsBeingDragged count])
+            return nil;
+
+        window = (WineWindow*)[NSApp keyWindow];
+        if (![window isKindOfClass:[WineWindow class]] || ![window isVisible] || [window isMiniaturized])
+            return nil;
+        return window;
+    }
+
+    /* Cursor, clipping and focus changes often come in bursts (a client hides
+       the cursor, then clips it); settle once they are all applied. */
+    - (void) updateRelativeMouse
+    {
+        if (relativeMouseUpdateScheduled)
+            return;
+        relativeMouseUpdateScheduled = TRUE;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            WineWindow* target;
+
+            relativeMouseUpdateScheduled = FALSE;
+            target = [self relativeMouseTarget];
+            if (relativeMouseWindow && target != relativeMouseWindow)
+                [self leaveRelativeMouse];
+            if (target && !relativeMouseWindow)
+                [self enterRelativeMouse:target];
+        });
+    }
+
+    - (void) enterRelativeMouse:(WineWindow*)window
+    {
+        NSRect content = [window contentRectForFrameRect:[window frame]];
+        NSPoint location = [NSEvent mouseLocation];
+        CGPoint position;
+
+        [self startRawInput];
+
+        relativeWarpDelta = CGPointZero;
+        if (!NSMouseInRect(location, NSInsetRect(content, 1, 1), NO))
+        {
+            // Freeze the pointer over the window, so clicks go to it.  The warp
+            // shows up in the next pointer event's delta; subtract it there.
+            NSPoint center = NSMakePoint(NSMidX(content), NSMidY(content));
+            CGPoint from = NSPointToCGPoint([self flippedMouseLocation:location]);
+            CGPoint to = NSPointToCGPoint([self flippedMouseLocation:center]);
+
+            CGSetLocalEventsSuppressionInterval(0);
+            if (CGWarpMouseCursorPosition(to) == kCGErrorSuccess)
+            {
+                relativeWarpDelta = CGPointMake(to.x - from.x, to.y - from.y);
+                location = center;
+            }
+            CGSetLocalEventsSuppressionInterval(0.25);
+        }
+
+        if (CGAssociateMouseAndMouseCursorPosition(false) != kCGErrorSuccess)
+        {
+            relativeWarpDelta = CGPointZero;
+            return;
+        }
+
+        position = cgpoint_win_from_mac(NSPointToCGPoint([self flippedMouseLocation:location]));
+
+        relativeMouseWindow = [window retain];
+        relativeRemainderX = relativeRemainderY = 0;
+        os_unfair_lock_lock(&relative_lock);
+        relative_position = CGPointMake(floor(position.x), floor(position.y));
+        __atomic_store_n(&relative_on, 1, __ATOMIC_RELEASE);
+        os_unfair_lock_unlock(&relative_lock);
+        [self updateRawInput];
+    }
+
+    - (void) leaveRelativeMouse
+    {
+        WineWindow* window = relativeMouseWindow;
+        CGPoint position;
+
+        if (!window) return;
+
+        // Stop raw input first, so the position read below is final.
+        relativeMouseWindow = nil;
+        [self updateRawInput];
+        os_unfair_lock_lock(&relative_lock);
+        __atomic_store_n(&relative_on, 0, __ATOMIC_RELEASE);
+        position = relative_position;
+        os_unfair_lock_unlock(&relative_lock);
+
+        CGAssociateMouseAndMouseCursorPosition(true);
+
+        // Show the pointer where the client left its cursor; not when the
+        // application lost activation, the user is going somewhere else.
+        if ([NSApp isActive] && [window isVisible])
+            [self setCursorPosition:cgpoint_mac_from_win(position)];
+
+        [window release];
+        relativeRemainderX = relativeRemainderY = 0;
+        relativeWarpDelta = CGPointZero;
+        forceNextMouseMoveAbsolute = TRUE;
+    }
+
+    - (BOOL) recordRelativeMousePosition:(CGPoint)pos
+    {
+        if (!relativeMouseWindow) return NO;
+        os_unfair_lock_lock(&relative_lock);
+        relative_position = pos;
+        os_unfair_lock_unlock(&relative_lock);
+        return YES;
+    }
+
+    - (void) noteClientWarp
+    {
+        if (!relativeMouseHiddenWarp && (clientWantsCursorHidden || cursorTransparent))
+        {
+            relativeMouseHiddenWarp = TRUE;
+            [self updateRelativeMouse];
+        }
+    }
+
+    /* Pointer events stand in for raw motion. */
+    - (void) handleRelativeMouseMove:(NSEvent*)anEvent
+    {
+        double scale = retina_on ? 2 : 1;
+        WineWindow* window = mouseCaptureWindow ? mouseCaptureWindow : relativeMouseWindow;
+        macdrv_event* event;
+        int x, y;
+
+        if (__atomic_load_n(&raw_on, __ATOMIC_ACQUIRE) &&
+            uptime_ns() - __atomic_load_n(&raw_last_motion, __ATOMIC_RELAXED) < raw_silence)
+        {
+            relativeWarpDelta = CGPointZero;
+            return;
+        }
+
+        // deltaY is already top-down, like Windows.
+        relativeRemainderX += ([anEvent deltaX] - relativeWarpDelta.x) * scale;
+        relativeRemainderY += ([anEvent deltaY] - relativeWarpDelta.y) * scale;
+        relativeWarpDelta = CGPointZero;
+        x = relativeRemainderX;  // truncation keeps the remainder
+        y = relativeRemainderY;
+        if (!x && !y) return;
+        relativeRemainderX -= x;
+        relativeRemainderY -= y;
+
+        event = macdrv_create_event(MOUSE_MOVED_RELATIVE, window);
+        event->mouse_moved.x = x;
+        event->mouse_moved.y = y;
+        event->mouse_moved.time_ms = [self ticksForEventTime:[anEvent timestamp]];
+        event->mouse_moved.drag = [anEvent type] != NSEventTypeMouseMoved;
+        [window.queue postEvent:event];
+        macdrv_release_event(event);
+
+        os_unfair_lock_lock(&relative_lock);
+        relative_move_position(x, y);
+        os_unfair_lock_unlock(&relative_lock);
+    }
+
+    /* Starts GCMouse raw input, once, the first time the mode is entered. */
+    - (void) startRawInput
+    {
+        dispatch_queue_attr_t attributes;
+
+        if (rawInputStarted)
+            return;
+        rawInputStarted = TRUE;
+
+        attributes = dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INTERACTIVE, 0);
+        attributes = dispatch_queue_attr_make_with_autorelease_frequency(attributes, DISPATCH_AUTORELEASE_FREQUENCY_WORK_ITEM);
+        raw_queue = dispatch_queue_create("org.winehq.wine.winemac.raw-mouse", attributes);
+        raw_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, DISPATCH_TIMER_STRICT, raw_queue);
+        dispatch_source_set_event_handler(raw_timer, ^{ raw_flush(); });
+        dispatch_source_set_timer(raw_timer, DISPATCH_TIME_FOREVER, DISPATCH_TIME_FOREVER, 0);
+        dispatch_resume(raw_timer);
+
+        rawMice = [[NSMutableArray alloc] init];
+        [[NSNotificationCenter defaultCenter] addObserverForName:GCMouseDidConnectNotification object:nil
+                                                           queue:[NSOperationQueue mainQueue]
+                                                      usingBlock:^(NSNotification* note){ [self attachRawMouse:note.object]; }];
+        [[NSNotificationCenter defaultCenter] addObserverForName:GCMouseDidDisconnectNotification object:nil
+                                                           queue:[NSOperationQueue mainQueue]
+                                                      usingBlock:^(NSNotification* note){ [self detachRawMouse:note.object]; }];
+        for (GCMouse* mouse in [GCMouse mice])
+            [self attachRawMouse:mouse];
+    }
+
+    - (void) attachRawMouse:(GCMouse*)mouse
+    {
+        // Trackpads keep pointer events: aiming with one relies on macOS's
+        // pointer acceleration.  GCMouse has no public way to tell them apart
+        // except the name ("Apple Internal Keyboard / Trackpad", "Magic Trackpad").
+        if ([mouse.vendorName rangeOfString:@"Trackpad" options:NSCaseInsensitiveSearch].location != NSNotFound)
+            return;
+        if ([rawMice containsObject:mouse]) return;
+        [rawMice addObject:mouse];
+        mouse.handlerQueue = raw_queue;
+        mouse.mouseInput.mouseMovedHandler = ^(GCMouseInput* input, float deltaX, float deltaY){
+            raw_motion(deltaX, deltaY);
+        };
+    }
+
+    - (void) detachRawMouse:(GCMouse*)mouse
+    {
+        if (![rawMice containsObject:mouse]) return;
+        mouse.mouseInput.mouseMovedHandler = nil;
+        [rawMice removeObject:mouse];
+    }
+
+    /* Raw motion goes to the relative mode's window while there is one. */
+    - (void) updateRawInput
+    {
+        WineWindow* window = raw_queue ? relativeMouseWindow : nil;
+        WineWindow* previous;
+
+        os_unfair_lock_lock(&relative_lock);
+        previous = raw_window;
+        raw_window = [window retain];
+        __atomic_store_n(&raw_on, window != nil, __ATOMIC_RELEASE);
+        os_unfair_lock_unlock(&relative_lock);
+        [previous release];
+    }
+
