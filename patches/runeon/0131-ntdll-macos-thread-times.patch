From: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Subject: [PATCH] ntdll: Report per-thread CPU times on macOS.

Adapted for CrossOver 26.3 from gauthierpiarrette/highball-engine
commit 9dc1026e911b722369ed9903c060475c0421e59b (patch 0024 of the
msfs-gsbase branch), code unchanged. A downstream fix, not a WineHQ
backport.

get_thread_times() has Linux and libprocstat bodies only, so on macOS
ThreadTimes answered zero for any other thread, and for the current
thread NtQueryInformationThread() fell back to the times of the whole
process. Windows reports each thread's own kernel and user time.

On macOS, read the thread's times with thread_info(THREAD_BASIC_INFO)
on the Mach thread port the server recorded for it, which
get_unix_tid() takes from mach_thread_self() and which is only valid
inside the same task. For another process the call still fails, as
before.

diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index f1324c7..97f7ef5 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -2004,6 +2004,26 @@ BOOL get_thread_times(int unix_pid, int unix_tid, LARGE_INTEGER *kernel_time, LA
     }
     procstat_close(pstat);
     return ret;
+#elif defined(__APPLE__)
+    /* unix_tid is the Mach thread port name from get_unix_tid(); it is only
+     * meaningful inside the same task. */
+    thread_basic_info_data_t info;
+    mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+
+    if (unix_pid != getpid())
+    {
+        static int once;
+        if (!once++) FIXME("cross-process thread times not supported on this platform\n");
+        return FALSE;
+    }
+    if (thread_info( (thread_act_t)unix_tid, THREAD_BASIC_INFO, (thread_info_t)&info, &count ) != KERN_SUCCESS)
+    {
+        WARN("thread_info failed for thread port %#x\n", unix_tid);
+        return FALSE;
+    }
+    kernel_time->QuadPart = (ULONGLONG)info.system_time.seconds * 10000000 + (ULONGLONG)info.system_time.microseconds * 10;
+    user_time->QuadPart   = (ULONGLONG)info.user_time.seconds * 10000000 + (ULONGLONG)info.user_time.microseconds * 10;
+    return TRUE;
 #else
     static int once;
     if (!once++) FIXME("not implemented on this platform\n");
