-    for (i = 0; i < ARRAY_SIZE(files); i++)
-    {
-        if (directory_length + wcslen(files[i]) >= ARRAY_SIZE(path)) return STATUS_SUCCESS;
-        wcscpy( path + directory_length, files[i] );
