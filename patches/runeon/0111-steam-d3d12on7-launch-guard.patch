-    HANDLE parent = 0, debug = 0;
+    HANDLE parent = 0, debug = 0, guard_mutex = NULL;
+    BOOL prepare_only = FALSE;
     ULONG nt_flags = 0;
     USHORT machine = 0;
     NTSTATUS status;
@@ -853,7 +933,8 @@
 
     /* Process the AppName and/or CmdLine to get module name and path */
 
