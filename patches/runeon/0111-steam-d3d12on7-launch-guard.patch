+           debugstr_w(app_name), debugstr_w(cmd_line), flags, inherit, startup_info->dwFlags, !!token );
 
     if (new_token) FIXME( "No support for returning created process token\n" );
 
@@ -952,8 +1033,15 @@
 
     if (!(flags & (DEBUG_PROCESS | DEBUG_ONLY_THIS_PROCESS)))
     {
-        if ((status = runeon_nwjs_launch_command( params, &nwjs_cmdline ))) goto done;
-        if (nwjs_cmdline)
