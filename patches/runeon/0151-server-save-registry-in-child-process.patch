+/* The periodic save runs in a forked copy of the server: writing a large
+ * branch blocks the request loop, and every client waits for it. */
+static pid_t save_pid;        /* process writing the periodic save, 0 if none */
+static timeout_t save_start;  /* when it was started (monotonic time) */
+
 unsigned int supported_machines_count = 0;
 unsigned short supported_machines[8];
 unsigned short native_machine = 0;
@@ -2132,15 +2140,91 @@ done:
 }
 
 /* periodic saving of the registry */
+/* write the dirty branches in a child process; returns 0 if it could not be started */
+static int start_save_process(void)
+{
+#ifdef __APPLE__
+    sigset_t all;
+    pid_t pid;
+    int i, fd, ok = 1;
+
+    if ((pid = fork()) == -1) return 0;
+    if (pid)
+    {
+        save_pid = pid;
+        save_start = monotonic_time;
+        for (i = 0; i < save_branch_count; i++)
+        {
+            /* the child writes the branch as it is now; later changes dirty it again */
+            save_branch_info[i].in_child = !!(save_branch_info[i].key->flags & KEY_DIRTY);
+            make_clean( save_branch_info[i].key );
+        }
+        return 1;
+    }
+
+    /* child: only write files, then leave without running exit handlers */
+    sigfillset( &all );
+    sigprocmask( SIG_SETMASK, &all, NULL );
+    if (fchdir( config_dir_fd ) == -1) _exit( 1 );
+    /* don't keep client connections open if the server dies first */
+    for (fd = getdtablesize() - 1; fd > 2; fd--) close( fd );
+    for (i = 0; i < save_branch_count; i++)
+        if (!save_branch( save_branch_info[i].key, save_branch_info[i].filename )) ok = 0;
+    _exit( ok ? 0 : 1 );
+#else
+    /* elsewhere the SIGCHLD handler reaps children without telling the registry */
+    return 0;
+#endif
+}
+
+/* a child process exited; status is from waitpid, or -1 if it is unknown */
+void registry_child_exited( pid_t pid, int status )
+{
+    int i, saved = status != -1 && WIFEXITED( status ) && !WEXITSTATUS( status );
+
+    if (!save_pid || pid != save_pid) return;
+    save_pid = 0;
+    for (i = 0; i < save_branch_count; i++)
+    {
+        /* a failed save leaves the whole branch to be written again */
+        if (save_branch_info[i].in_child && !saved) save_branch_info[i].key->flags |= KEY_DIRTY;
+        save_branch_info[i].in_child = 0;
+    }
+    if (!saved) fprintf( stderr, "wineserver: periodic registry save failed (status %#x)\n", status );
+}
+
+/* wait for a running periodic save, so that nothing older can replace what is written next */
+static void wait_for_save_process(void)
+{
+    pid_t ret;
+    int status;
+
+    if (!save_pid) return;
+    while ((ret = waitpid( save_pid, &status, 0 )) == -1 && errno == EINTR);
+    if (ret != save_pid) status = -1;
+    registry_child_exited( save_pid, status );
+}
+
 static void periodic_save( void *arg )
 {
-    int i;
+    int i, dirty = 0;
 
-    if (fchdir( config_dir_fd ) == -1) return;
     save_timeout_user = NULL;
+    if (save_pid)
+    {
+        /* still writing the previous save; stop it if it hangs, its branches stay dirty */
+        if (monotonic_time - save_start > 60 * TICKS_PER_SEC) kill( save_pid, SIGKILL );
+        set_periodic_save_timer();
+        return;
+    }
     for (i = 0; i < save_branch_count; i++)
-        save_branch( save_branch_info[i].key, save_branch_info[i].filename );
-    if (fchdir( server_dir_fd ) == -1) fatal_error( "chdir to server dir: %s\n", strerror( errno ));
+        if (save_branch_info[i].key->flags & KEY_DIRTY) dirty = 1;
+    if (dirty && !start_save_process() && fchdir( config_dir_fd ) != -1)
+    {
+        for (i = 0; i < save_branch_count; i++)
+            save_branch( save_branch_info[i].key, save_branch_info[i].filename );
+        if (fchdir( server_dir_fd ) == -1) fatal_error( "chdir to server dir: %s\n", strerror( errno ));
+    }
     set_periodic_save_timer();
 }
 
