-    assert(0);  /* should never be called on MacOS */
+    pid_t pid;
+    int status;
+
+    /* the only child processes on macOS are periodic registry saves */
+    while ((pid = waitpid( -1, &status, WNOHANG )) > 0) registry_child_exited( pid, status );
 }
 
