diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index bfeae78..7db1e1d 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -340,6 +340,26 @@ static void sync_window_opacity(struct macdrv_win_data *data, BYTE alpha,
 }
 
 
+/***********************************************************************
+ *              sync_window_sheet_of_glass
+ *
+ * dwmapi sets this property for a window whose frame was extended over the
+ * whole client area ("sheet of glass"), where DWM would composite the
+ * window's alpha channel onto the desktop.
+ */
+static void sync_window_sheet_of_glass(struct macdrv_win_data *data)
+{
+    static const WCHAR sheet_of_glassW[] = {'_','_','w','i','n','e','_','d','w','m','_','s','h','e','e','t','_','o','f','_','g','l','a','s','s',0};
+    BOOL sheet_of_glass = NtUserGetProp(data->hwnd, sheet_of_glassW) != 0;
+
+    if (!data->sheet_of_glass == !sheet_of_glass) return;
+
+    TRACE("setting window %p/%p sheet-of-glass to %d\n", data->hwnd, data->cocoa_window, sheet_of_glass);
+    macdrv_window_set_sheet_of_glass(data->cocoa_window, sheet_of_glass);
+    data->sheet_of_glass = sheet_of_glass;
+}
+
+
