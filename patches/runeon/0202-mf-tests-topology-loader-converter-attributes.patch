From: Runeon Contributors <dev@runeon.com>
Subject: [PATCH] mf/tests: Test converter output types inheriting upstream attributes.

A source with an uncompressed video type is connected to a sink that,
like the EVR, has no current type, enumerates none, and accepts only
types with frame size and MF_MT_ALL_SAMPLES_INDEPENDENT. The only
converter is a locally registered test MFT whose output type has
neither. The topology must resolve through the converter, whose output
type keeps its own interlace mode and gains the upstream attributes,
while the converter's enumerated type and the source's current type
stay unchanged. The test sink handler gains an optional required type
for this.

diff --git a/dlls/mf/tests/topology.c b/dlls/mf/tests/topology.c
--- a/dlls/mf/tests/topology.c
+++ b/dlls/mf/tests/topology.c
@@ -1674,6 +1674,7 @@ struct test_handler
     ULONG set_current_count;
     IMFMediaType *current_type;
     IMFMediaType *invalid_type;
+    IMFMediaType *required_type;
 
     ULONG enum_count;
     ULONG media_types_count;
@@ -1721,6 +1722,10 @@ static HRESULT WINAPI test_handler_IsMediaTypeSupported(IMFMediaTypeHandler *ifa
             MF_ATTRIBUTES_MATCH_OUR_ITEMS, &result) == S_OK && result)
         return MF_E_INVALIDMEDIATYPE;
 
+    if (impl->required_type && (IMFMediaType_Compare(impl->required_type, (IMFAttributes *)in_type,
+            MF_ATTRIBUTES_MATCH_OUR_ITEMS, &result) != S_OK || !result))
+        return MF_E_INVALIDMEDIATYPE;
+
     if (!impl->current_type)
         return S_OK;
 
@@ -2962,6 +2967,240 @@ todo_wine {
     IMFSampleGrabberSinkCallback_Release(grabber_callback);
 }
 
+static const GUID test_converter_input_subtype = {0x30494354, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID test_converter_output_subtype = {0x304f4354, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static IMFMediaType *test_converter_types[2];
+
+static HRESULT WINAPI test_converter_factory_QueryInterface(IClassFactory *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IClassFactory) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI test_converter_factory_AddRef(IClassFactory *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI test_converter_factory_Release(IClassFactory *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI test_converter_factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID riid, void **out)
+{
+    IMFTransform *transform;
+    HRESULT hr;
+
+    *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+
+    hr = test_transform_create(1, &test_converter_types[0], 1, &test_converter_types[1], FALSE, &transform);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    /* start without current types, like a newly created converter */
+    IMFTransform_SetInputType(transform, 0, NULL, 0);
+    IMFTransform_SetOutputType(transform, 0, NULL, 0);
+
+    hr = IMFTransform_QueryInterface(transform, riid, out);
+    IMFTransform_Release(transform);
+    return hr;
+}
+
+static HRESULT WINAPI test_converter_factory_LockServer(IClassFactory *iface, BOOL lock)
+{
+    return S_OK;
+}
+
+static const IClassFactoryVtbl test_converter_factory_vtbl =
+{
+    test_converter_factory_QueryInterface,
+    test_converter_factory_AddRef,
+    test_converter_factory_Release,
+    test_converter_factory_CreateInstance,
+    test_converter_factory_LockServer,
+};
+
+static void test_topology_loader_converter_attributes(void)
+{
+    static const media_type_desc source_desc =
+    {
+        ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
+        ATTR_GUID(MF_MT_SUBTYPE, test_converter_input_subtype),
+        ATTR_RATIO(MF_MT_FRAME_SIZE, 96, 96),
+        ATTR_RATIO(MF_MT_FRAME_RATE, 30, 1),
+        ATTR_UINT32(MF_MT_ALL_SAMPLES_INDEPENDENT, 1),
+        ATTR_UINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive),
+    };
+    /* the converter enumerates output types without frame size or MF_MT_ALL_SAMPLES_INDEPENDENT */
+    static const media_type_desc converter_output_desc =
+    {
+        ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
+        ATTR_GUID(MF_MT_SUBTYPE, test_converter_output_subtype),
+        ATTR_UINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_MixedInterlaceOrProgressive),
+    };
+    /* like the EVR mixer, the sink rejects a type without MF_MT_ALL_SAMPLES_INDEPENDENT as compressed */
+    static const media_type_desc sink_required_desc =
+    {
+        ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
+        ATTR_GUID(MF_MT_SUBTYPE, test_converter_output_subtype),
+        ATTR_RATIO(MF_MT_FRAME_SIZE, 96, 96),
+        ATTR_UINT32(MF_MT_ALL_SAMPLES_INDEPENDENT, 1),
+    };
+    static const media_type_desc expect_output_desc =
+    {
+        ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
+        ATTR_GUID(MF_MT_SUBTYPE, test_converter_output_subtype),
+        ATTR_RATIO(MF_MT_FRAME_SIZE, 96, 96),
+        ATTR_RATIO(MF_MT_FRAME_RATE, 30, 1),
+        ATTR_UINT32(MF_MT_ALL_SAMPLES_INDEPENDENT, 1),
+        ATTR_UINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_MixedInterlaceOrProgressive),
+    };
+    const MFT_REGISTER_TYPE_INFO input_info[] = {{MFMediaType_Video, test_converter_input_subtype}};
+    const MFT_REGISTER_TYPE_INFO output_info[] =
+    {
+        /* video processors also list their input subtype as an output */
+        {MFMediaType_Video, test_converter_input_subtype},
+        {MFMediaType_Video, test_converter_output_subtype},
+    };
+    IClassFactory factory = {.lpVtbl = &test_converter_factory_vtbl};
+    struct test_stream_sink stream_sink = test_stream_sink;
+    IMFTopologyNode *src_node, *sink_node, *node, *converter_node;
+    struct test_handler handler = test_handler;
+    IMFMediaTypeHandler *type_handler;
+    IMFTopology *topology, *full_topology;
+    IMFMediaType *source_type, *media_type;
+    IMFPresentationDescriptor *pd;
+    IMFStreamDescriptor *sd;
+    IMFTransform *transform;
+    IMFMediaSource *source;
+    IMFTopoLoader *loader;
+    WORD node_count;
+    IUnknown *object;
+    TOPOID node_id;
+    UINT32 count;
+    DWORD index;
+    HRESULT hr;
+
+    hr = MFStartup(MF_VERSION, MFSTARTUP_FULL);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+
+    hr = MFTRegisterLocal(&factory, &MFT_CATEGORY_VIDEO_PROCESSOR, L"Test Converter", 0,
+            ARRAY_SIZE(input_info), input_info, ARRAY_SIZE(output_info), output_info);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+
+    hr = MFCreateMediaType(&source_type);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    init_media_type(source_type, source_desc, -1);
+    hr = MFCreateMediaType(&test_converter_types[0]);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    init_media_type(test_converter_types[0], source_desc, -1);
+    hr = MFCreateMediaType(&test_converter_types[1]);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    init_media_type(test_converter_types[1], converter_output_desc, -1);
+    hr = MFCreateMediaType(&handler.required_type);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    init_media_type(handler.required_type, sink_required_desc, -1);
+
+    /* like the EVR, the sink has no current type and enumerates none */
+    handler.media_types = &media_type;
+    handler.media_types_count = 0;
+    stream_sink.handler = &handler.IMFMediaTypeHandler_iface;
+
+    create_descriptors(1, &source_type, &source_desc, &pd, &sd);
+    source = create_test_source(pd);
+
+    hr = MFCreateTopology(&topology);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = MFCreateTopologyNode(MF_TOPOLOGY_SOURCESTREAM_NODE, &src_node);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    init_source_node(source, -1, src_node, pd, sd);
+    hr = IMFTopology_AddNode(topology, src_node);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = MFCreateTopologyNode(MF_TOPOLOGY_OUTPUT_NODE, &sink_node);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    init_sink_node(&stream_sink.IMFStreamSink_iface, -1, sink_node);
+    hr = IMFTopology_AddNode(topology, sink_node);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IMFTopologyNode_ConnectOutput(src_node, 0, sink_node, 0);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+
+    hr = MFCreateTopoLoader(&loader);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+
+    /* the loader inserts the converter and completes its output type from the upstream type */
+    hr = IMFTopoLoader_Load(loader, topology, &full_topology, NULL);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    if (hr == S_OK)
+    {
+        hr = IMFTopology_GetNodeCount(full_topology, &node_count);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        ok(node_count == 3, "got node_count %u.\n", node_count);
+
+        hr = IMFTopologyNode_GetTopoNodeID(sink_node, &node_id);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IMFTopology_GetNodeByID(full_topology, node_id, &node);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IMFTopologyNode_GetInput(node, 0, &converter_node, &index);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        IMFTopologyNode_Release(node);
+        hr = IMFTopologyNode_GetObject(converter_node, &object);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        IMFTopologyNode_Release(converter_node);
+        hr = IUnknown_QueryInterface(object, &IID_IMFTransform, (void **)&transform);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        IUnknown_Release(object);
+
+        hr = IMFTransform_GetOutputCurrentType(transform, 0, &media_type);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        check_media_type(media_type, expect_output_desc, -1);
+        IMFMediaType_Release(media_type);
+        IMFTransform_Release(transform);
+
+        IMFTopology_Release(full_topology);
+    }
+
+    /* neither the type the converter enumerated nor the source current type is modified */
+    check_media_type(test_converter_types[1], converter_output_desc, -1);
+    hr = IMFMediaType_GetCount(test_converter_types[1], &count);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(count == 3, "got count %u.\n", count);
+    hr = IMFStreamDescriptor_GetMediaTypeHandler(sd, &type_handler);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IMFMediaTypeHandler_GetCurrentMediaType(type_handler, &media_type);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    check_media_type(media_type, source_desc, -1);
+    hr = IMFMediaType_GetCount(media_type, &count);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(count == 6, "got count %u.\n", count);
+    IMFMediaType_Release(media_type);
+    IMFMediaTypeHandler_Release(type_handler);
+
+    IMFTopoLoader_Release(loader);
+    IMFTopology_Release(topology);
+    IMFTopologyNode_Release(src_node);
+    IMFTopologyNode_Release(sink_node);
+    IMFMediaSource_Release(source);
+    IMFPresentationDescriptor_Release(pd);
+    IMFStreamDescriptor_Release(sd);
+    IMFMediaType_Release(handler.required_type);
+    IMFMediaType_Release(test_converter_types[1]);
+    IMFMediaType_Release(test_converter_types[0]);
+    IMFMediaType_Release(source_type);
+
+    hr = MFTUnregisterLocal(&factory);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = MFShutdown();
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+}
+
 static void test_topology_loader_evr(void)
 {
     static const media_type_desc media_type_desc =
@@ -3768,6 +4007,7 @@ START_TEST(topology)
     test_topology();
     test_topology_tee_node();
     test_topology_loader();
+    test_topology_loader_converter_attributes();
     test_topology_loader_evr();
     test_topology_loader_d3d();
     test_topology_loader_d3d9(MFTOPOLOGY_DXVA_DEFAULT);
