From: Runeon Contributors <dev@runeon.com>
Subject: [PATCH] ntdll: Let a thread read back its debug registers under Rosetta.

Rosetta has no x86 debug registers. The server refuses to set them, an
existing CrossOver change reports success anyway, and a later read goes
to the server, which returns zero. A program that writes the debug
registers and checks what it reads back, through NtGetContextThread or
in an exception context, then sees zero where Windows returns its own
values.

With RUNEON_DEBUG_REGISTER_READBACK_V1=1, NtGetContextThread on the
current thread returns the values the thread last set, which are already
kept for exception contexts, instead of overwriting them with the
server's zeros. Breakpoints still never fire. The first faked set in a
process logs one ERR line with a fixed marker so the failure can be
recognised in default logs. Without the variable nothing changes.

---
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 4b8e52c..4f509b8 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -1108,6 +1108,26 @@ void *get_wow_context( CONTEXT *context )
 }
 
 
+#ifdef __APPLE__
+/* Rosetta has no x86 debug registers: the server refuses to set them and reads
+ * them back as zero. A program that writes them and checks what it reads back,
+ * directly or in an exception context, then sees zero where Windows returns its
+ * own values. With RUNEON_DEBUG_REGISTER_READBACK_V1=1 the calling thread reads
+ * its debug registers from the values it last set; breakpoints still never fire. */
+static BOOL debug_register_readback(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *value = getenv( "RUNEON_DEBUG_REGISTER_READBACK_V1" );
+        enabled = value && !strcmp( value, "1" );
+    }
+    return enabled;
+}
+#endif
+
+
 /***********************************************************************
  *              NtSetContextThread  (NTDLL.@)
  *              ZwSetContextThread  (NTDLL.@)
@@ -1151,6 +1171,14 @@ NTSTATUS WINAPI NtSetContextThread( HANDLE handle, const CONTEXT *context )
             /* CW HACK 22131 */
             WARN_(seh)( "Setting debug registers is not supported under Rosetta, faking success\n" );
             ret = STATUS_SUCCESS;
+            if (debug_register_readback())
+            {
+                static LONG reported;
+
+                /* Fixed text: the launcher looks for it in default logs. */
+                if (!InterlockedExchange( &reported, 1 ))
+                    ERR_(seh)( "RUNEON_DEBUG_REGISTER_READBACK_V1: debug registers kept for read-back only\n" );
+            }
         }
 #endif
         if (ret || !self) return ret;
@@ -1334,6 +1362,18 @@ NTSTATUS WINAPI NtGetContextThread( HANDLE handle, CONTEXT *context )
             frame->restore_flags |= CONTEXT_XSTATE;
         }
     }
+#ifdef __APPLE__
+    /* the server reads them as zero under Rosetta; return what this thread set */
+    if ((needed_flags & CONTEXT_DEBUG_REGISTERS) && debug_register_readback())
+    {
+        context->Dr0 = amd64_thread_data()->dr0;
+        context->Dr1 = amd64_thread_data()->dr1;
+        context->Dr2 = amd64_thread_data()->dr2;
+        context->Dr3 = amd64_thread_data()->dr3;
+        context->Dr6 = amd64_thread_data()->dr6;
+        context->Dr7 = amd64_thread_data()->dr7;
+    }
+#endif
     /* update the cached version of the debug registers */
     if (needed_flags & CONTEXT_DEBUG_REGISTERS)
     {
