diff --git a/server/runeon_launch.c b/server/runeon_launch.c
new file mode 100644
index 0000000..090ab7a
--- /dev/null
+++ b/server/runeon_launch.c
@@ -0,0 +1,160 @@
+/*
+ * Managed launch validation.
+ *
+ * Copyright (C) 2026 Runeon
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "runeon_launch.h"
+
+#if defined(RUNEON_MANAGED_LAUNCH_VALIDATION) && defined(__APPLE__)
+
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+
+#define RUNEON_REQUEST_MAGIC "RNLNCH01"
+#define RUNEON_RESPONSE_MAGIC "RNLNRS01"
+#define RUNEON_PROTOCOL_VERSION 1
+#define RUNEON_TOKEN_LENGTH 64
+#define RUNEON_MAX_PATH_LENGTH 4096
+
+static int send_all( int fd, const void *buffer, size_t length )
+{
+    const char *cursor = buffer;
+
+    while (length)
+    {
+        ssize_t count = send( fd, cursor, length, 0 );
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) return 0;
+        cursor += count;
+        length -= count;
+    }
+    return 1;
+}
+
+static int receive_all( int fd, void *buffer, size_t length )
+{
+    char *cursor = buffer;
+
+    while (length)
+    {
+        ssize_t count = recv( fd, cursor, length, 0 );
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) return 0;
+        cursor += count;
+        length -= count;
+    }
+    return 1;
+}
+
+static void put_uint16( unsigned char *destination, uint16_t value )
+{
+    destination[0] = value >> 8;
+    destination[1] = value & 0xff;
+}
+
+static uint16_t get_uint16( const unsigned char *source )
+{
+    return ((uint16_t)source[0] << 8) | source[1];
+}
+
+static int connect_gatekeeper( const char *socket_path )
+{
+    struct sockaddr_un address;
+    struct timeval timeout = { 1, 0 };
+    int fd;
+
+    if (strlen( socket_path ) >= sizeof(address.sun_path)) return -1;
+    if ((fd = socket( AF_UNIX, SOCK_STREAM, 0 )) < 0) return -1;
+    if (setsockopt( fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout) ) ||
+        setsockopt( fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout) ))
+    {
+        close( fd );
+        return -1;
+    }
+    memset( &address, 0, sizeof(address) );
+    address.sun_family = AF_UNIX;
+    address.sun_len = sizeof(address);
+    strcpy( address.sun_path, socket_path );
+    if (connect( fd, (const struct sockaddr *)&address, sizeof(address) ))
+    {
+        close( fd );
+        return -1;
+    }
+    return fd;
+}
+
+int runeon_validate_managed_launch(void)
+{
+    const char *socket_environment = getenv( "RUNEON_LAUNCH_GATE_SOCKET" );
+    const char *token_environment = getenv( "RUNEON_LAUNCH_GATE_GRANT" );
+    const char *runtime_environment = getenv( "RUNEON_LAUNCH_GATE_RUNTIME" );
+    const char *prefix_environment = getenv( "WINEPREFIX" );
+    char *socket_path = socket_environment ? strdup( socket_environment ) : NULL;
+    char *token = token_environment ? strdup( token_environment ) : NULL;
+    char *runtime = runtime_environment ? strdup( runtime_environment ) : NULL;
+    char *prefix = prefix_environment ? strdup( prefix_environment ) : NULL;
+    unsigned char header[16], response[12];
+    size_t prefix_length, runtime_length;
+    int fd = -1, valid = 0;
+
+    unsetenv( "RUNEON_LAUNCH_GATE_SOCKET" );
+    unsetenv( "RUNEON_LAUNCH_GATE_GRANT" );
+    unsetenv( "RUNEON_LAUNCH_GATE_RUNTIME" );
+
+    if (!socket_path || !token || !runtime || !prefix) goto done;
+    prefix_length = strlen( prefix );
+    runtime_length = strlen( runtime );
+    if (strlen( token ) != RUNEON_TOKEN_LENGTH || !prefix_length || !runtime_length ||
+        prefix_length > RUNEON_MAX_PATH_LENGTH || runtime_length > RUNEON_MAX_PATH_LENGTH ||
+        prefix_length > UINT16_MAX || runtime_length > UINT16_MAX) goto done;
+
+    if ((fd = connect_gatekeeper( socket_path )) < 0) goto done;
+    memcpy( header, RUNEON_REQUEST_MAGIC, 8 );
+    put_uint16( header + 8, RUNEON_PROTOCOL_VERSION );
+    put_uint16( header + 10, RUNEON_TOKEN_LENGTH );
+    put_uint16( header + 12, prefix_length );
+    put_uint16( header + 14, runtime_length );
+    if (!send_all( fd, header, sizeof(header) ) ||
+        !send_all( fd, token, RUNEON_TOKEN_LENGTH ) ||
+        !send_all( fd, prefix, prefix_length ) ||
+        !send_all( fd, runtime, runtime_length ) ||
+        !receive_all( fd, response, sizeof(response) )) goto done;
+    valid = !memcmp( response, RUNEON_RESPONSE_MAGIC, 8 ) &&
+            get_uint16( response + 8 ) == RUNEON_PROTOCOL_VERSION && response[10] == 1;
+
+done:
+    if (fd >= 0) close( fd );
+    if (token)
+    {
+        memset( token, 0, strlen(token) );
+        free( token );
+    }
+    free( socket_path );
+    free( runtime );
+    free( prefix );
+    return valid;
+}
+
+#else
+
+int runeon_validate_managed_launch(void)
+{
+    return 1;
+}
+
+#endif
