+/* Wait for objects released on MF threads; an engine kept alive by a reference cycle never gets there. */
+static LONG wait_refcount(LONG *refcount, LONG expected)
+{
+    unsigned int i;
+
+    for (i = 0; i < 50 && *refcount != expected; ++i)
+        Sleep(100);
+
+    return *refcount;
+}
+
+static void test_shutdown_during_load(void)
+{
+    static IMFActivate activate = { &test_activate_vtbl };
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+    struct media_engine_notify *notify;
+    IMFMediaEngineEx *media_engine;
+    struct test_source *source;
+    IMFByteStream *stream;
+    unsigned int i;
+    LONG refcount;
+    HANDLE file;
+    HRESULT hr;
+    DWORD res;
+    BOOL ret;
+    BSTR url;
+
+    if (!pMFRegisterLocalByteStreamHandler)
+    {
+        win_skip("Local handlers are not supported.\n");
+        return;
+    }
+
+    /* The handler stays registered for the rest of the process. */
+    test_handler.IMFByteStreamHandler_iface.lpVtbl = &test_handler_vtbl;
+    test_handler.request_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    hr = pMFRegisterLocalByteStreamHandler(L".mftest", NULL, &activate);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    GetTempPathW(ARRAY_SIZE(path), path);
+    ret = GetTempFileNameW(path, L"mfe", 0, dir);
+    ok(ret, "Failed to get a temporary name, error %lu.\n", GetLastError());
+    if (!ret)
+        return;
+    ret = DeleteFileW(dir) && CreateDirectoryW(dir, NULL);
+    ok(ret, "Failed to create directory, error %lu.\n", GetLastError());
+    if (!ret)
+        return;
+    lstrcpyW(path, dir);
+    lstrcatW(path, L"\\test.mftest");
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_NEW, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "Failed to create file, error %lu.\n", GetLastError());
+    if (file == INVALID_HANDLE_VALUE)
+        goto cleanup;
+    CloseHandle(file);
+
+    hr = MFCreateTempFile(MF_ACCESSMODE_READ | MF_ACCESSMODE_WRITE, MF_OPENMODE_FAIL_IF_EXIST, MF_FILEFLAGS_NONE, &stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    /* The load completes after Shutdown(): 0 from a URL, 1 from a URL with an error, 2 from a byte stream. */
+    for (i = 0; i < 3; ++i)
+    {
+        winetest_push_context("%u", i);
+
+        notify = create_callback();
+        hr = create_media_engine(&notify->IMFMediaEngineNotify_iface, NULL, DXGI_FORMAT_UNKNOWN,
+                &IID_IMFMediaEngineEx, (void **)&media_engine);
+        if (FAILED(hr))
+        {
+            win_skip("IMFMediaEngineEx is not supported.\n");
+            IMFMediaEngineNotify_Release(&notify->IMFMediaEngineNotify_iface);
+            winetest_pop_context();
+            break;
+        }
+
+        url = SysAllocString(i == 2 ? L"test.mftest" : path);
+        if (i == 2)
+            hr = IMFMediaEngineEx_SetSourceFromByteStream(media_engine, stream, url);
+        else
+            hr = IMFMediaEngineEx_SetSource(media_engine, url);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        SysFreeString(url);
+        res = WaitForSingleObject(test_handler.request_event, 5000);
+        ok(!res, "Unexpected res %#lx.\n", res);
+
+        hr = IMFMediaEngineEx_Shutdown(media_engine);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+        source = NULL;
+        if (i != 1)
+        {
+            source = calloc(1, sizeof(*source));
+            source->IMFMediaSource_iface.lpVtbl = &test_source_vtbl;
+            source->refcount = 1;
+            source->shutdown_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+        }
+        complete_test_request(source ? (IUnknown *)&source->IMFMediaSource_iface : NULL,
+                source ? S_OK : HRESULT_FROM_WIN32(ERROR_INVALID_DATA));
+
+        if (source)
+        {
+            res = WaitForSingleObject(source->shutdown_event, 5000);
+            ok(!res, "Source was not shut down, res %#lx.\n", res);
+        }
+
+        IMFMediaEngineEx_Release(media_engine);
+        refcount = wait_refcount(&notify->refcount, 1);
+        ok(refcount == 1, "Unexpected refcount %ld.\n", refcount);
+        IMFMediaEngineNotify_Release(&notify->IMFMediaEngineNotify_iface);
+
+        if (source)
+        {
+            wait_refcount(&source->refcount, 1);
+            refcount = IMFMediaSource_Release(&source->IMFMediaSource_iface);
+            ok(!refcount, "Unexpected refcount %ld.\n", refcount);
+        }
+
+        winetest_pop_context();
+    }
+
+    IMFByteStream_Release(stream);
+
+cleanup:
+    DeleteFileW(path);
+    RemoveDirectoryW(dir);
+}
+
 START_TEST(mfmediaengine)
 {
     HRESULT hr;
@@ -2959,6 +3547,7 @@ START_TEST(mfmediaengine)
     test_GetSeekable();
