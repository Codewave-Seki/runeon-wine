+/* Keeps one request pending until the test thread completes it. */
+static struct
+{
+    IMFByteStreamHandler IMFByteStreamHandler_iface;
+    HANDLE request_event;
+    IMFAsyncCallback *callback;
+    IUnknown *state;
+} test_handler;
+
+static HRESULT WINAPI test_handler_QueryInterface(IMFByteStreamHandler *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IMFByteStreamHandler) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI test_handler_AddRef(IMFByteStreamHandler *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI test_handler_Release(IMFByteStreamHandler *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI test_handler_BeginCreateObject(IMFByteStreamHandler *iface, IMFByteStream *stream,
+        const WCHAR *url, DWORD flags, IPropertyStore *props, IUnknown **cancel_cookie, IMFAsyncCallback *callback,
+        IUnknown *state)
+{
+    if (cancel_cookie)
+        *cancel_cookie = NULL;
+
+    ok(!test_handler.callback, "Unexpected request.\n");
+    test_handler.callback = callback;
+    IMFAsyncCallback_AddRef(callback);
+    if ((test_handler.state = state))
+        IUnknown_AddRef(state);
+    SetEvent(test_handler.request_event);
+
+    return S_OK;
+}
+
+static HRESULT WINAPI test_handler_EndCreateObject(IMFByteStreamHandler *iface, IMFAsyncResult *result,
+        MF_OBJECT_TYPE *obj_type, IUnknown **object)
+{
+    HRESULT hr = IMFAsyncResult_GetStatus(result);
+
+    *obj_type = MF_OBJECT_INVALID;
+    *object = NULL;
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IMFAsyncResult_GetObject(result, object)))
+        *obj_type = MF_OBJECT_MEDIASOURCE;
+
+    return hr;
+}
+
+static HRESULT WINAPI test_handler_CancelObjectCreation(IMFByteStreamHandler *iface, IUnknown *cancel_cookie)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI test_handler_GetMaxNumberOfBytesRequiredForResolution(IMFByteStreamHandler *iface,
+        QWORD *bytes)
+{
+    return E_NOTIMPL;
+}
+
+static const IMFByteStreamHandlerVtbl test_handler_vtbl =
+{
+    test_handler_QueryInterface,
+    test_handler_AddRef,
+    test_handler_Release,
+    test_handler_BeginCreateObject,
+    test_handler_EndCreateObject,
+    test_handler_CancelObjectCreation,
+    test_handler_GetMaxNumberOfBytesRequiredForResolution,
+};
+
+static void complete_test_request(IUnknown *object, HRESULT status)
+{
+    IMFAsyncResult *result;
+    HRESULT hr;
+
+    if (!test_handler.callback)
+        return;
+
+    hr = MFCreateAsyncResult(object, test_handler.callback, test_handler.state, &result);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IMFAsyncResult_SetStatus(result, status);
+    hr = MFInvokeCallback(result);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IMFAsyncResult_Release(result);
+
+    IMFAsyncCallback_Release(test_handler.callback);
+    test_handler.callback = NULL;
+    if (test_handler.state)
+        IUnknown_Release(test_handler.state);
+    test_handler.state = NULL;
+}
