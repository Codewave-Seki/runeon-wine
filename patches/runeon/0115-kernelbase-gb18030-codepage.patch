+
+static unsigned int gb18030_linear( const unsigned char *src )
+{
+    return (((src[0] - 0x81) * 10 + (src[1] - 0x30)) * 126 + (src[2] - 0x81)) * 10 + (src[3] - 0x30);
+}
+
+static BOOL gb18030_is_dbcs_trail( unsigned char ch )
+{
+    return (ch >= 0x40 && ch <= 0x7e) || (ch >= 0x80 && ch <= 0xfe);
+}
+
+static BOOL gb18030_is_four_byte( const unsigned char *src, int srclen )
+{
+    return srclen >= 4 && src[1] >= 0x30 && src[1] <= 0x39 && src[2] >= 0x81 && src[2] <= 0xfe &&
+           src[3] >= 0x30 && src[3] <= 0x39;
+}
+
+static WCHAR gb18030_dbcs_to_wchar( const CPTABLEINFO *gbk, unsigned char lead, unsigned char trail )
+{
+    USHORT code = (lead << 8) | trail;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(gb18030_dbcs_override); i++)
+        if (gb18030_dbcs_override[i].code == code) return gb18030_dbcs_override[i].wch;
+    return gbk->DBCSOffsets[gbk->DBCSOffsets[lead] + trail];
+}
+
+/* returns the two-byte code for a BMP character, or 0 if it needs four bytes */
+static USHORT gb18030_wchar_to_dbcs( const CPTABLEINFO *gbk, WCHAR wch )
+{
+    const USHORT *table = gbk->WideCharTable;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(gb18030_dbcs_override); i++)
+        if (gb18030_dbcs_override[i].wch == wch) return gb18030_dbcs_override[i].code;
+    /* the 936 table also best-fits, so only an exact round trip counts */
+    if ((table[wch] & 0xff00) && gb18030_dbcs_to_wchar( gbk, table[wch] >> 8, table[wch] & 0xff ) == wch)
+        return table[wch];
+    return 0;
+}
+
+static int mbstowcs_gb18030( DWORD flags, const unsigned char *src, int srclen, WCHAR *dst, int dstlen )
+{
+    const CPTABLEINFO *gbk = get_codepage_table( 936 );
+    unsigned int linear, min, max, pos;
+    int len = 0, used, count;
+    WCHAR wch[2];
+
+    if (!gbk) return 0;
+    for ( ; srclen; src += used, srclen -= used)
+    {
+        used = 1;
+        count = 1;
+        wch[0] = 0;
+        if (*src < 0x80) wch[0] = *src;
+        else if (*src == 0x80 || *src == 0xff) wch[0] = 0;
+        else if (srclen >= 2 && gb18030_is_dbcs_trail( src[1] ))
+        {
+            wch[0] = gb18030_dbcs_to_wchar( gbk, src[0], src[1] );
+            used = 2;
+        }
+        else if (gb18030_is_four_byte( src, srclen ))
+        {
+            used = 4;
+            linear = gb18030_linear( src );
+            if (src[0] <= 0x84)
+            {
+                min = 0;
+                max = ARRAY_SIZE(gb18030_ranges) - 1;
+                while (min <= max && max < ARRAY_SIZE(gb18030_ranges))
+                {
+                    pos = (min + max) / 2;
+                    if (linear < gb18030_ranges[pos].linear) max = pos - 1;
+                    else if (linear >= gb18030_ranges[pos].linear + gb18030_ranges[pos].count) min = pos + 1;
+                    else
+                    {
+                        wch[0] = gb18030_ranges[pos].wch + (linear - gb18030_ranges[pos].linear);
+                        break;
+                    }
+                }
+            }
+            else if (src[0] >= 0x90 && linear - GB18030_SUPPLEMENTARY_LINEAR < 0x100000)
+            {
+                linear -= GB18030_SUPPLEMENTARY_LINEAR;
+                wch[0] = 0xd800 | (linear >> 10);
+                wch[1] = 0xdc00 | (linear & 0x3ff);
+                count = 2;
+            }
+        }
+        /* NUL is only ever a single byte, so zero marks an invalid sequence */
+        if (!wch[0] && *src)
+        {
+            if (flags & MB_ERR_INVALID_CHARS)
+            {
+                SetLastError( ERROR_NO_UNICODE_TRANSLATION );
+                return 0;
+            }
+            wch[0] = 0xfffd;
+            count = 1;
+        }
+        if (dstlen)
+        {
+            if (len + count > dstlen)
+            {
+                SetLastError( ERROR_INSUFFICIENT_BUFFER );
+                return 0;
+            }
+            memcpy( dst + len, wch, count * sizeof(WCHAR) );
+        }
+        len += count;
+    }
+    return len;
 }
 
+static int wcstombs_gb18030( DWORD flags, const WCHAR *src, int srclen, char *dst, int dstlen,
+                             const char *defchar, BOOL *used )
+{
+    const CPTABLEINFO *gbk = get_codepage_table( 936 );
+    unsigned int linear = 0, i;
+    int len = 0, count, consumed;
+    unsigned char buf[4];
+    USHORT code;
+    WCHAR wch;
 
+    if (used) *used = FALSE;
+    if (!gbk) return 0;
+    for ( ; srclen; src += consumed, srclen -= consumed)
+    {
+        wch = *src;
+        consumed = 1;
+        count = 0;
+        if (wch < 0x80)
+        {
+            buf[0] = wch;
+            count = 1;
+        }
+        else if (IS_HIGH_SURROGATE( wch ) && srclen > 1 && IS_LOW_SURROGATE( src[1] ))
+        {
+            linear = GB18030_SUPPLEMENTARY_LINEAR + (((wch & 0x3ff) << 10) | (src[1] & 0x3ff));
+            consumed = 2;
+            count = 4;
+        }
+        else if (!IS_SURROGATE( wch ))
+        {
+            if ((code = gb18030_wchar_to_dbcs( gbk, wch )))
+            {
+                buf[0] = code >> 8;
+                buf[1] = code & 0xff;
+                count = 2;
+            }
+            else
+            {
+                for (i = 0; i < ARRAY_SIZE(gb18030_ranges); i++)
+                {
+                    if (wch >= gb18030_ranges[i].wch && wch < gb18030_ranges[i].wch + gb18030_ranges[i].count)
+                    {
+                        linear = gb18030_ranges[i].linear + (wch - gb18030_ranges[i].wch);
+                        count = 4;
+                        break;
+                    }
+                }
+            }
+        }
+        if (count == 4)
+        {
+            buf[3] = 0x30 + linear % 10;
+            linear /= 10;
+            buf[2] = 0x81 + linear % 126;
+            linear /= 126;
+            buf[1] = 0x30 + linear % 10;
+            buf[0] = 0x81 + linear / 10;
+        }
+        else if (!count)
+        {
+            /* a lone surrogate, the only UTF-16 that GB18030 cannot encode */
+            if (flags & WC_ERR_INVALID_CHARS)
+            {
+                SetLastError( ERROR_NO_UNICODE_TRANSLATION );
+                return 0;
+            }
+            if (used) *used = TRUE;
+            buf[0] = defchar ? defchar[0] : '?';
+            count = 1;
+        }
+        if (dstlen)
+        {
+            if (len + count > dstlen)
+            {
+                SetLastError( ERROR_INSUFFICIENT_BUFFER );
+                return 0;
+            }
+            memcpy( dst + len, buf, count );
+        }
+        len += count;
+    }
+    return len;
+}
+
