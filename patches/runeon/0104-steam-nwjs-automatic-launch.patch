diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -38,6 +38,113 @@
 
 static DWORD shutdown_flags = 0;
 static DWORD shutdown_priority = 0x280;
+
+static const WCHAR runeon_nwjs_wrapperW[] = L"C:\\runeon-input-source\\runeon-input-source-launch.exe";
+
+/* Only the Steam middleware's own process creation is eligible. The App
+ * decides runtime versions and protection; Wine knows no game identifiers. */
+static NTSTATUS runeon_nwjs_launch_command( RTL_USER_PROCESS_PARAMETERS *params, WCHAR **command )
+{
+    static const WCHAR *files[] = { L"nw.dll", L"nw_elf.dll", L"package.json" };
+    const WCHAR *argument, *end;
+    const WCHAR *parent = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+    WCHAR enabled[2], grant[65], appid[32], path[32768], *name;
+    UNICODE_STRING key, value;
+    DWORD attributes;
+    HANDLE file, section;
+    SECTION_IMAGE_INFORMATION image;
+    NTSTATUS status;
+    size_t length, directory_length;
+    unsigned int i;
+    BOOL nonzero = FALSE;
+
+    *command = NULL;
+    if (!parent) return STATUS_SUCCESS;
+    if ((name = wcsrchr( parent, '\\' ))) parent = name + 1;
+    if (wcsicmp( parent, L"steam.exe" )) return STATUS_SUCCESS;
+
+    /* A pass-through helper must preserve lpApplicationName semantics.
+     * If the first argument differs, leave the original creation untouched. */
+    if (!(argument = params->CommandLine.Buffer) || wcschr( argument, '\n' )
+        || wcschr( argument, '\r' )) return STATUS_SUCCESS;
+    if (*argument == '"')
+    {
+        if (!(end = wcschr( ++argument, '"' ))) return STATUS_SUCCESS;
+        if (end[1] && end[1] != ' ' && end[1] != '\t') return STATUS_SUCCESS;
+    }
+    else
+    {
+        for (end = argument; *end && *end != ' ' && *end != '\t'; end++);
+    }
+    if ((end - argument) * sizeof(WCHAR) != params->ImagePathName.Length
+        || wcsnicmp( argument, params->ImagePathName.Buffer, end - argument )) return STATUS_SUCCESS;
+
+    RtlInitUnicodeString( &key, L"RUNEON_NWJS_AUTO_V1" );
+    value.Buffer = enabled;
+    value.MaximumLength = sizeof(enabled);
+    if (RtlQueryEnvironmentVariable_U( params->Environment, &key, &value )
+        || value.Length != sizeof(WCHAR) || enabled[0] != '1') return STATUS_SUCCESS;
+
+    RtlInitUnicodeString( &key, L"RUNEON_INPUT_SOURCE_GRANT" );
+    value.Buffer = grant;
+    value.MaximumLength = sizeof(grant);
+    if (RtlQueryEnvironmentVariable_U( params->Environment, &key, &value )
+        || value.Length != 64 * sizeof(WCHAR)) return STATUS_SUCCESS;
+    for (i = 0; i < 64; i++)
+        if (!((grant[i] >= '0' && grant[i] <= '9') || (grant[i] >= 'a' && grant[i] <= 'f')))
+            return STATUS_SUCCESS;
+
+    RtlInitUnicodeString( &key, L"SteamAppId" );
+    value.Buffer = appid;
+    value.MaximumLength = sizeof(appid);
+    if (RtlQueryEnvironmentVariable_U( params->Environment, &key, &value ) || !value.Length)
+        return STATUS_SUCCESS;
+    for (i = 0; i < value.Length / sizeof(WCHAR); i++)
+    {
+        if (appid[i] < '0' || appid[i] > '9') return STATUS_SUCCESS;
+        if (appid[i] != '0') nonzero = TRUE;
+    }
+    if (!nonzero) return STATUS_SUCCESS;
+
+    /* kernelbase cannot import kernel32's GetBinaryTypeW. Query the image
+     * directly and leave unrecognized or unreadable executables untouched. */
+    file = CreateFileW( params->ImagePathName.Buffer, GENERIC_READ, FILE_SHARE_READ,
+                        NULL, OPEN_EXISTING, 0, 0 );
+    if (file == INVALID_HANDLE_VALUE) return STATUS_SUCCESS;
+    status = NtCreateSection( &section, STANDARD_RIGHTS_REQUIRED | SECTION_QUERY,
+                              NULL, NULL, PAGE_READONLY, SEC_IMAGE, file );
+    CloseHandle( file );
+    if (status) return STATUS_SUCCESS;
+    status = NtQuerySection( section, SectionImageInformation, &image, sizeof(image), NULL );
+    CloseHandle( section );
+    if (status || image.Machine != IMAGE_FILE_MACHINE_AMD64
+        || (image.ImageCharacteristics & IMAGE_FILE_DLL)) return STATUS_SUCCESS;
+    length = params->ImagePathName.Length / sizeof(WCHAR);
+    if (!length || length >= ARRAY_SIZE(path)) return STATUS_SUCCESS;
+    memcpy( path, params->ImagePathName.Buffer, length * sizeof(WCHAR) );
+    path[length] = 0;
+    if (!(name = wcsrchr( path, '\\' ))) return STATUS_SUCCESS;
+    directory_length = name + 1 - path;
+    for (i = 0; i < ARRAY_SIZE(files); i++)
+    {
+        if (directory_length + wcslen(files[i]) >= ARRAY_SIZE(path)) return STATUS_SUCCESS;
+        wcscpy( path + directory_length, files[i] );
+        attributes = GetFileAttributesW( path );
+        if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY))
+            return STATUS_SUCCESS;
+    }
+    attributes = GetFileAttributesW( runeon_nwjs_wrapperW );
+    if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY)) return STATUS_SUCCESS;
+
+    length = wcslen(runeon_nwjs_wrapperW) + params->CommandLine.Length / sizeof(WCHAR)
+             + wcslen(L"\"\" --runtime nwjs-auto -- ") + 1;
+    if (length >= 32767) return STATUS_SUCCESS;
+    if (!(*command = HeapAlloc( GetProcessHeap(), 0, length * sizeof(WCHAR) ))) return STATUS_SUCCESS;
+    swprintf( *command, length, L"\"%s\" --runtime nwjs-auto -- %s",
+              runeon_nwjs_wrapperW, params->CommandLine.Buffer );
+    return STATUS_SUCCESS;
+}
+
 
 static BOOL is_steamwebhelper_command( const WCHAR *app_name, const WCHAR *cmd_line )
 {
@@ -732,7 +839,7 @@
 {
     const struct proc_thread_attr *handle_list = NULL, *job_list = NULL;
     WCHAR name[MAX_PATH];
-    WCHAR *p, *tidy_cmdline = cmd_line;
+    WCHAR *p, *tidy_cmdline = cmd_line, *nwjs_cmdline = NULL;
     RTL_USER_PROCESS_PARAMETERS *params = NULL;
     RTL_USER_PROCESS_INFORMATION rtl_info = { 0 };
     HANDLE parent = 0, debug = 0;
@@ -841,6 +948,16 @@
     {
         status = STATUS_NO_MEMORY;
         goto done;
+    }
+
+    if (!(flags & (DEBUG_PROCESS | DEBUG_ONLY_THIS_PROCESS)))
+    {
+        if ((status = runeon_nwjs_launch_command( params, &nwjs_cmdline ))) goto done;
+        if (nwjs_cmdline)
+        {
+            RtlInitUnicodeString( &params->ImagePathName, runeon_nwjs_wrapperW );
+            RtlInitUnicodeString( &params->CommandLine, nwjs_cmdline );
+        }
     }
 
     if (flags & (DEBUG_PROCESS | DEBUG_ONLY_THIS_PROCESS))
@@ -964,6 +1081,7 @@
     if (epic_launcher_hack) startup_info->lpDesktop = orig_lpDesktop;
 
     RtlDestroyProcessParameters( params );
+    HeapFree( GetProcessHeap(), 0, nwjs_cmdline );
     if (tidy_cmdline != cmd_line) HeapFree( GetProcessHeap(), 0, tidy_cmdline );
     return set_ntstatus( status );
 }
