From: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Subject: [PATCH] opengl32: Answer GL_ARB_ES2_compatibility's calls in legacy contexts.

Adapted for CrossOver 26.3 from gauthierpiarrette/highball-engine
commit 15ab7f975db540d82104dade2d55c2ffd135e10b (patch 0021), code
unchanged. A downstream fix, not a WineHQ backport.

macOS gives a program that creates an OpenGL context without
attributes a legacy 2.1 context, and lists GL_ARB_ES2_compatibility
only in its 4.1 core contexts, so opengl32 withholds the extension's
calls there and wglGetProcAddress() returns nothing. Programs written
against OpenGL ES 2 load them anyway, since Windows drivers offer them
in any context, and call the empty pointer: a Loom engine game crashed
at address 0 right after loading glClearDepthf, and its loader fails
on the first of the five calls it cannot get.

When the extension is missing, glClearDepthf and glDepthRangef now go
through glClearDepth and glDepthRange, glGetShaderPrecisionFormat
answers what desktop drivers answer (single precision floats, 32-bit
integers), and glReleaseShaderCompiler and glShaderBinary do nothing,
next to the existing alternatives table. A context that has the
extension is unchanged.

diff --git a/dlls/opengl32/unix_wgl.c b/dlls/opengl32/unix_wgl.c
index 6fd2d0e..e77da1b 100644
--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -961,6 +961,51 @@ static int registry_entry_cmp( const void *a, const void *b )
     return strcmp( entry_a->name, entry_b->name );
 }
 
+/* GL_ARB_ES2_compatibility's calls. macOS lists that extension only in 4.1 core contexts, but
+ * programs written against OpenGL ES 2 call these in a legacy (2.1) context too, which every
+ * Windows driver allows. The depth calls go through the double precision core ones. */
+static void compat_glClearDepthf( GLfloat d )
+{
+    const struct opengl_funcs *funcs = NtCurrentTeb()->glTable;
+    funcs->p_glClearDepth( d );
+}
+
+static void compat_glDepthRangef( GLfloat n, GLfloat f )
+{
+    const struct opengl_funcs *funcs = NtCurrentTeb()->glTable;
+    funcs->p_glDepthRange( n, f );
+}
+
+/* What desktop drivers answer: IEEE single precision floats and 32-bit integers. */
+static void compat_glGetShaderPrecisionFormat( GLenum shadertype, GLenum precisiontype, GLint *range, GLint *precision )
+{
+    switch (precisiontype)
+    {
+    case GL_LOW_FLOAT:
+    case GL_MEDIUM_FLOAT:
+    case GL_HIGH_FLOAT:
+        range[0] = range[1] = 127;
+        *precision = 23;
+        break;
+    case GL_LOW_INT:
+    case GL_MEDIUM_INT:
+    case GL_HIGH_INT:
+        range[0] = 31;
+        range[1] = 30;
+        *precision = 0;
+        break;
+    }
+}
+
+static void compat_glReleaseShaderCompiler(void)
+{
+}
+
+/* No binary formats are listed without the extension, so there is nothing to load. */
+static void compat_glShaderBinary( GLsizei count, const GLuint *shaders, GLenum binaryformat, const void *binary, GLsizei length )
+{
+}
+
 PROC wrap_wglGetProcAddress( TEB *teb, LPCSTR name )
 {
     const struct registry_entry entry = {.name = name}, *found;
@@ -997,6 +1042,22 @@ PROC wrap_wglGetProcAddress( TEB *teb, LPCSTR name )
                 { "glVertexAttribDivisor", "glVertexAttribDivisorARB"},  /* needed by Caffeine */
                 { "glCompressedTexImage2DARB", "glCompressedTexImage2D" }, /* needed by Grim Fandango Remastered */
             };
+            static const struct { const char *name; const void *func; } emulated[] =
+            {
+                { "glClearDepthf", compat_glClearDepthf },  /* needed by Paperback: The Game (Loom) */
+                { "glDepthRangef", compat_glDepthRangef },
+                { "glGetShaderPrecisionFormat", compat_glGetShaderPrecisionFormat },
+                { "glReleaseShaderCompiler", compat_glReleaseShaderCompiler },
+                { "glShaderBinary", compat_glShaderBinary },
+            };
+
+            for (i = 0; i < ARRAY_SIZE(emulated); i++)
+            {
+                if (strcmp( name, emulated[i].name )) continue;
+                WARN( "Extension %s required for %s not supported, emulating it\n", found->extension, name );
+                *func_ptr = emulated[i].func;
+                return (void *)(UINT_PTR)(found - extension_registry);
+            }
 
             for (i = 0; i < ARRAY_SIZE(alternatives); i++)
             {
