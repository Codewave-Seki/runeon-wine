+            free(e);
+        }
+    }
+    if (engine->notify_idle)
+        CloseHandle(engine->notify_idle);
+    DeleteCriticalSection(&engine->notify_cs);
     DeleteCriticalSection(&engine->cs);
     free(engine->video_frame.buffer);
     free(engine);
@@ -1652,7 +1797,7 @@ static HRESULT media_engine_set_source(struct media_engine *engine, IMFByteStrea
 
     engine->ready_state = MF_MEDIA_ENGINE_READY_HAVE_NOTHING;
 
-    IMFMediaEngineNotify_EventNotify(engine->callback, MF_MEDIA_ENGINE_EVENT_PURGEQUEUEDEVENTS, 0, 0);
+    media_engine_notify(engine, MF_MEDIA_ENGINE_EVENT_PURGEQUEUEDEVENTS, 0, 0);
 
     engine->network_state = MF_MEDIA_ENGINE_NETWORK_NO_SOURCE;
 
@@ -1897,16 +2042,16 @@ static HRESULT media_engine_set_current_time(struct media_engine *engine, double
     if (IMFMediaEngineEx_IsPaused(&engine->IMFMediaEngineEx_iface))
     {
         engine->presentation.start_position = position;
