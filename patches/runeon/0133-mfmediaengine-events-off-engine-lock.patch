From: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Subject: [PATCH] mfmediaengine: Deliver events from a work-queue thread, never under the engine lock.

Adapted for CrossOver 26.3 from gauthierpiarrette/highball-engine
commit 34c5f770862674c03e8cb3af5b223d3e7ae81aba (arm64 patch 0040,
written against Wine 11.18). The two session events that 11.18
raises after a scrubbing check are raised unconditionally in the 11.0
code, as before; otherwise the code is unchanged. A downstream fix,
not a WineHQ backport.

The media engine called the application's
IMFMediaEngineNotify::EventNotify() with engine->cs held, on the
caller's thread in Play(), Pause(), SetSource() and the setters, and
on the work-queue thread for session events. An application whose
callback takes a lock of its own while another of its threads holds
that lock and calls any engine method deadlocks: one thread holds the
application's lock and waits for engine->cs, the other holds
engine->cs inside the callback and waits for the application's lock.
Windows delivers these events asynchronously without such a lock.

Events now go through media_engine_notify(), which appends them to a
FIFO under a small lock of its own, never held during a callback, and
schedules one dispatcher work item on the multithreaded queue when
none is running; the dispatcher drains the FIFO in order. Shutdown()
waits up to 10 s for the queue to drain after the session's shutdown,
outside engine->cs, and events raised after Shutdown() are dropped.

diff --git a/dlls/mfmediaengine/main.c b/dlls/mfmediaengine/main.c
index 6fa1c42..a0d7f92 100644
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -37,6 +37,7 @@
 #include "mediaengine_private.h"
 
 #include "wine/debug.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
 
@@ -144,8 +145,15 @@ struct media_engine
     IMFAsyncCallback session_events;
     IMFAsyncCallback sink_events;
     IMFAsyncCallback load_handler;
+    IMFAsyncCallback notify_callback;
     LONG refcount;
     IMFMediaEngineNotify *callback;
+    /* Events for the application, delivered from a work-queue thread, never under cs. */
+    CRITICAL_SECTION notify_cs;
+    struct list notify_events;
+    BOOL notify_running;
+    DWORD notify_thread;
+    HANDLE notify_idle;
     IMFAttributes *attributes;
     IMFDXGIDeviceManager *device_manager;
     HANDLE device_handle;
@@ -921,6 +929,132 @@ static HRESULT WINAPI media_engine_callback_GetParameters(IMFAsyncCallback *ifac
     return E_NOTIMPL;
 }
 
+struct notify_event
+{
+    struct list entry;
+    DWORD event;
+    DWORD_PTR param1;
+    DWORD param2;
+};
+
+static struct media_engine *impl_from_notify_IMFAsyncCallback(IMFAsyncCallback *iface)
+{
+    return CONTAINING_RECORD(iface, struct media_engine, notify_callback);
+}
+
+static ULONG WINAPI media_engine_notify_AddRef(IMFAsyncCallback *iface)
+{
+    struct media_engine *engine = impl_from_notify_IMFAsyncCallback(iface);
+    return IMFMediaEngineEx_AddRef(&engine->IMFMediaEngineEx_iface);
+}
+
+static ULONG WINAPI media_engine_notify_Release(IMFAsyncCallback *iface)
+{
+    struct media_engine *engine = impl_from_notify_IMFAsyncCallback(iface);
+    return IMFMediaEngineEx_Release(&engine->IMFMediaEngineEx_iface);
+}
+
+/* The dispatcher: delivers the queued events in order, on this work-queue thread, with no engine lock held. */
+static HRESULT WINAPI media_engine_notify_Invoke(IMFAsyncCallback *iface, IMFAsyncResult *result)
+{
+    struct media_engine *engine = impl_from_notify_IMFAsyncCallback(iface);
+    struct notify_event *e;
+    struct list *head;
+
+    engine->notify_thread = GetCurrentThreadId();
+    for (;;)
+    {
+        EnterCriticalSection(&engine->notify_cs);
+        if (!(head = list_head(&engine->notify_events)))
+        {
+            engine->notify_running = FALSE;
+            engine->notify_thread = 0;
+            SetEvent(engine->notify_idle);
+            LeaveCriticalSection(&engine->notify_cs);
+            break;
+        }
+        list_remove(head);
+        LeaveCriticalSection(&engine->notify_cs);
+
+        e = LIST_ENTRY(head, struct notify_event, entry);
+        IMFMediaEngineNotify_EventNotify(engine->callback, e->event, e->param1, e->param2);
+        free(e);
+    }
+
+    IMFMediaEngineEx_Release(&engine->IMFMediaEngineEx_iface);
+    return S_OK;
+}
+
+static const IMFAsyncCallbackVtbl media_engine_notify_vtbl =
+{
+    media_engine_callback_QueryInterface,
+    media_engine_notify_AddRef,
+    media_engine_notify_Release,
+    media_engine_callback_GetParameters,
+    media_engine_notify_Invoke,
+};
+
+/* Queue an event for the application. Called with engine->cs held; the callback runs later, without it. */
+static void media_engine_notify(struct media_engine *engine, DWORD event, DWORD_PTR param1, DWORD param2)
+{
+    struct notify_event *e;
+    BOOL schedule = FALSE;
+    HRESULT hr;
+
+    if (engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+        return;
+    if (!(e = malloc(sizeof(*e))))
+        return;
+    e->event = event;
+    e->param1 = param1;
+    e->param2 = param2;
+
+    EnterCriticalSection(&engine->notify_cs);
+    list_add_tail(&engine->notify_events, &e->entry);
+    if (!engine->notify_running)
+    {
+        engine->notify_running = TRUE;
+        ResetEvent(engine->notify_idle);
+        schedule = TRUE;
+    }
+    LeaveCriticalSection(&engine->notify_cs);
+
+    if (!schedule)
+        return;
+
+    IMFMediaEngineEx_AddRef(&engine->IMFMediaEngineEx_iface);
+    if (FAILED(hr = MFPutWorkItem(MFASYNC_CALLBACK_QUEUE_MULTITHREADED, &engine->notify_callback, NULL)))
+    {
+        WARN("Failed to queue the notification, hr %#lx.\n", hr);
+        EnterCriticalSection(&engine->notify_cs);
+        engine->notify_running = FALSE;
+        SetEvent(engine->notify_idle);
+        LeaveCriticalSection(&engine->notify_cs);
+        IMFMediaEngineEx_Release(&engine->IMFMediaEngineEx_iface);
+    }
+}
+
+/* Wait for the queued events to be delivered. Called without engine->cs; a no-op on the dispatcher's own thread. */
+static void media_engine_notify_drain(struct media_engine *engine)
+{
+    unsigned int i;
+
+    if (GetCurrentThreadId() == engine->notify_thread)
+        return;
+    for (i = 0; i < 200; ++i)
+    {
+        BOOL running;
+
+        EnterCriticalSection(&engine->notify_cs);
+        running = engine->notify_running;
+        LeaveCriticalSection(&engine->notify_cs);
+        if (!running)
+            return;
+        WaitForSingleObject(engine->notify_idle, 50);
+    }
+    WARN("Notifications still pending after 10 s.\n");
+}
+
 static HRESULT media_engine_set_current_time(struct media_engine *engine, double seektime);
 
