     return S_OK;
 }
 
+struct notify_event
+{
+    struct list entry;
+    DWORD thread;
+    DWORD event;
+    DWORD_PTR param1;
+    DWORD param2;
+};
+
+/* Calls the application with the events this thread raised, in order, unless it still holds
+ * engine->cs. Windows calls IMFMediaEngineNotify on the thread that raised the event, during the
+ * call that raised it; the callback must not run under engine->cs, because it may take a lock of
+ * the application's that another thread holds while it calls the engine. After Shutdown() queued
+ * events are dropped. */
+static void media_engine_deliver_events(struct media_engine *engine)
+{
+    DWORD thread = GetCurrentThreadId();
+    struct notify_event *event;
+
+    if (engine->cs.OwningThread == ULongToHandle(thread))
+        return;
+
+    for (;;)
+    {
+        struct notify_event *found = NULL;
+
+        EnterCriticalSection(&engine->notify_cs);
+        LIST_FOR_EACH_ENTRY(event, &engine->notify_events, struct notify_event, entry)
+        {
+            if (event->thread != thread) continue;
+            list_remove(&event->entry);
+            found = event;
+            break;
+        }
+        LeaveCriticalSection(&engine->notify_cs);
+        if (!found) break;
+
+        if (!(engine->flags & FLAGS_ENGINE_SHUT_DOWN))
+            IMFMediaEngineNotify_EventNotify(engine->callback, found->event, found->param1, found->param2);
+        free(found);
+    }
+}
+
+static void media_engine_notify(struct media_engine *engine, DWORD event_type, DWORD_PTR param1, DWORD param2)
+{
+    struct notify_event *event;
+
+    if (engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+        return;
+    if (!(event = malloc(sizeof(*event))))
+        return;
+    event->thread = GetCurrentThreadId();
+    event->event = event_type;
+    event->param1 = param1;
+    event->param2 = param2;
+
+    EnterCriticalSection(&engine->notify_cs);
+    list_add_tail(&engine->notify_events, &event->entry);
+    LeaveCriticalSection(&engine->notify_cs);
+
+    media_engine_deliver_events(engine);
+}
+
+static void media_engine_unlock(struct media_engine *engine)
+{
+    LeaveCriticalSection(&engine->cs);
+    media_engine_deliver_events(engine);
+}
