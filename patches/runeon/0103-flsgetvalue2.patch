From: millia ampora <198710911+dappermint@users.noreply.github.com>
Subject: [PATCH] kernelbase: Add FlsGetValue2 without changing last error.

Adapted for CrossOver 26.3 from dappermint/winecx commit
e0aa380780b73e20fabcfe78fd42713b94929a53 and its preceding export addition.
This is a downstream candidate, not a WineHQ backport or a game-specific fix.
Reuse RtlFlsGetValue and preserve the existing FlsGetValue behavior.

--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -524,6 +524,7 @@
 @ stdcall -import FlsAlloc(ptr)
 @ stdcall -import FlsFree(long)
 @ stdcall -import FlsGetValue(long)
+@ stdcall -import FlsGetValue2(long)
 @ stdcall -import FlsSetValue(long ptr)
 @ stdcall -import FlushConsoleInputBuffer(long)
 @ stdcall -import FlushFileBuffers(long)
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -388,6 +388,7 @@
 @ stdcall FlsAlloc(ptr)
 @ stdcall FlsFree(long)
 @ stdcall FlsGetValue(long)
+@ stdcall FlsGetValue2(long)
 @ stdcall FlsSetValue(long ptr)
 @ stdcall FlushConsoleInputBuffer(long)
 @ stdcall FlushFileBuffers(long)
--- a/include/fibersapi.h
+++ b/include/fibersapi.h
@@ -28,6 +28,7 @@
 WINBASEAPI DWORD WINAPI FlsAlloc(PFLS_CALLBACK_FUNCTION);
 WINBASEAPI BOOL  WINAPI FlsFree(DWORD);
 WINBASEAPI void *WINAPI FlsGetValue(DWORD);
+WINBASEAPI void *WINAPI FlsGetValue2(DWORD);
 WINBASEAPI BOOL  WINAPI FlsSetValue(DWORD,void*);
 WINBASEAPI BOOL  WINAPI IsThreadAFiber(void);
 
--- a/dlls/kernelbase/thread.c
+++ b/dlls/kernelbase/thread.c
@@ -1313,6 +1313,18 @@
 
 
 /***********************************************************************
+ *           FlsGetValue2   (kernelbase.@)
+ */
+PVOID WINAPI DECLSPEC_HOTPATCH FlsGetValue2( DWORD index )
+{
+    void *data;
+
+    if (RtlFlsGetValue( index, &data )) return NULL;
+    return data;
+}
+
+
+/***********************************************************************
  *           FlsSetValue   (kernelbase.@)
  */
 BOOL WINAPI DECLSPEC_HOTPATCH FlsSetValue( DWORD index, PVOID data )
