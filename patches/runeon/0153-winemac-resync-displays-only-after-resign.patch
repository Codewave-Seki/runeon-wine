From: AsherJN
Subject: [PATCH] winemac.drv: Re-read the display list on activation only after a resign.

Adapted for CrossOver 26.3 from AsherJN/recall commit a436e4cd4fac44693b4d699acc030d17eec6f36e
(patches/wine-winemac-activation.patch, the activation_resync_needed part
only). A downstream fix, not a WineHQ backport.

applicationDidBecomeActive: synthesizes a displays-changed event so that
display changes made while another application was active reach Wine.
The recall project reports that macOS delivers that notification again
to an application that is already active, on every left click in a
full-screen game and without a resign in between, and that each one
makes the thread that owns the desktop re-read the display list. A
windowed test on this base did not reproduce it (one re-read for 43
clicks); the maintainer adopted the change without local reproduction.

Synthesize the event only after the application really resigned active,
after the screen configuration changed, and when the displays come back
after a permission dialog, as before. The first activation always does.

--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -37,6 +37,13 @@
 static NSString* const NSWindowWillStartDraggingNotification = @"NSWindowWillStartDraggingNotification";
 static NSString* const NSWindowDidEndDraggingNotification = @"NSWindowDidEndDraggingNotification";
 
+/* Whether the next applicationDidBecomeActive: must re-synchronize Wine's
+ * display list.  macOS is reported to re-announce an already active
+ * application in full-screen games without a resign in between; the re-sync
+ * is only needed after the application really resigned or the screen
+ * configuration changed.  Main thread only. */
+static BOOL activation_resync_needed = TRUE;
+
 // Internal distributed notification to handle cooperative app activation in Sonoma.
 static NSString* const WineAppWillActivateNotification = @"WineAppWillActivateNotification";
 static NSString* const WineActivatingAppPIDKey = @"ActivatingAppPID";
@@ -2105,6 +2112,7 @@ - (void) setupObservations
                     usingBlock:^(NSNotification *note){
             if (displaysTemporarilyUncapturedForDialog)
             {
+                activation_resync_needed = TRUE;
                 [self applicationDidBecomeActive:nil];
 
                 displaysTemporarilyUncapturedForDialog = FALSE;
@@ -2458,8 +2466,13 @@ - (void)applicationDidBecomeActive:(NSNotification *)notification
         //
         // To solve this, we synthesize a displays-changed event whenever we're
         // activated.  This will provoke a re-synchronization of Wine's notion of
-        // the desktop rect with the actual state.
-        [self sendDisplaysChanged:TRUE];
+        // the desktop rect with the actual state.  Only after a real resign:
+        // see activation_resync_needed.
+        if (activation_resync_needed)
+        {
+            activation_resync_needed = FALSE;
+            [self sendDisplaysChanged:TRUE];
+        }
 
         // The cursor probably moved while we were inactive.  Accumulated mouse
         // movement deltas are invalidated.  Make sure the next mouse move event
@@ -2470,6 +2483,7 @@ - (void)applicationDidBecomeActive:(NSNotification *)notification
     - (void)applicationDidChangeScreenParameters:(NSNotification *)notification
     {
         primaryScreenHeightValid = FALSE;
+        activation_resync_needed = TRUE;
         [self sendDisplaysChanged:FALSE];
         [self adjustWindowLevels];
 
@@ -2484,6 +2498,7 @@ - (void)applicationDidResignActive:(NSNotification *)notification
         macdrv_event* event;
         WineEventQueue* queue;
 
+        activation_resync_needed = TRUE;
         [self invalidateGotFocusEvents];
 
         if (!temporarilyIgnoreResignEventsForDialog)
