    ],
    "deferredCommits": [
      {
        "commit": "f34dda8a56d09d1ca4ce2e929fe2c83ccbd14c94",
        "reason": "Media Foundation control-flow and test prerequisites diverge from the pinned CrossOver branch."
      },
      {
        "commit": "a48b1ff36b6154a27be94c274b22d43ad06c1054",
        "reason": "CrossOver carries a divergent WinHTTP stream implementation and the upstream commit adds no in-tree regression test."
      },
      {
        "commit": "35b1e7eb9a7e66c49fac8583e50186c6c21736e6",
        "reason": "The source hunk applies but the matching SChannel test prerequisite does not; source-only backporting is not accepted."
      },
      {
        "commit": "b39db986571ed894334b992d8479b6deb9ddb23e",
        "reason": "The implementation moved from setupapi to cfgmgr32 upstream; this requires semantic adaptation and a matching legacy-layout test."
      },
      {
        "commit": "8840f1dae9a7fc873ebb635a0a054062880dba51",
        "reason": "The URI safety fix depends on the surrounding canonicalization series and must be evaluated as an ordered chain."
      },
      {
        "commit": "b0150eda77d7072d2238ec4cec27636a19811b10",
        "reason": "The ucrtbase test prerequisite rewrites unrelated test_cexp and test_expf assertions whose outcome depends on 11.x math fixes absent from the pinned base; source-only backporting is not accepted."
      },
      {
        "commit": "5e5fea8b9117b90ec8d6d1d8bf9038d41bf4fb49",
        "reason": "Switching UnhandledExceptionFilter from the PEB BeingDebugged flag to the debug port changes the crash path for titles that tamper with that flag and needs product evidence first."
      },
      {
        "commit": "3ec14378590503ffbadfa936b994e5bf849fe967",
        "reason": "Upstream converted the monitor DPI helpers to fractional ratios after 11.0, so the detached-source guard needs a hand-written adaptation in abi-sensitive display code with no upstream regression test."
      },
      {
        "commit": "4534f6cd04717a5ed445f568428143303841d1cc",
        "reason": "Rectifying the pixel aspect ratio adds new output behaviour rather than fixing a defect, and no Runeon title is known to need it."
      },
      {
        "commit": "a1bae27f21b53fa3ac6be6b08f4cbfb441360ade",
        "reason": "The fix targets the batched raw mouse input mechanism introduced after 11.0; the base has no info->raw_mouse path to repair."
      },
      {
        "commit": "f27d14a21cfef776cbd5c7871a269066e3f1dc87",
        "reason": "WINHTTP_OPTION_SERVER_CERT_CHAIN_CONTEXT does not exist in the pinned base; the fix requires porting the whole option first."
      },
      {
        "commit": "93ef2498b391902e560f0e4aa64a7c74abe40b4a",
        "reason": "Same missing WINHTTP_OPTION_SERVER_CERT_CHAIN_CONTEXT prerequisite as f27d14a21cfe."
      },
      {
        "commit": "852e39a89c0d6eae4fc35ff227577c7e8ae24c39",
        "reason": "pGetWindowStateUpdates is implemented only by winex11.drv; the host window state race the lock protects against does not exist on the macOS driver."
      },
      {
        "commit": "95e5d76a1882a91d91c436a28a2c5447a72c8545",
        "reason": "Planar CPU blits belong to the wined3d Vulkan H.264 decoder chain, which Runeon does not use because video decoding runs through D3DMetal and DXVK."
      },
      {
        "commit": "bfe591cbef5b7f0485031c8569e6d32a1b6d35ec",
        "reason": "The bound check it removes was added by 2e68942fce46 inside the same release window and never reached the pinned base, so the pair is a no-op here."
      }
    ],
    "decisionDocument": "AUDIT-11.0-11.15.md"
  },
